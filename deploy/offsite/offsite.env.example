# /etc/nyctala/offsite.env (root, 0600). Copy and fill in on the server.
#
# rclone remote for audit data: a bucket with Object Lock / WORM, and an access
# key that can write but not delete or overwrite. Configure the remote in
# /etc/nyctala/rclone.conf (`rclone config --config /etc/nyctala/rclone.conf`).
OFFSITE_REMOTE=nyctala-audit:nyctala-audit/siem-1

# restic repository for encrypted backups (can live on the same provider,
# preferably another bucket with object lock too).
RESTIC_REPOSITORY=rclone:nyctala-backup:nyctala-backup/siem-1

# Where deploy.sh puts the code (docker-compose.yml is in its deploy/ directory).
COMPOSE_DIR=/opt/nyctala/deploy
